# Puerto en el que se levanta el servicio (por defecto 4003 si no se define)
REPORTS_PORT=4003

# URL base de service-inventory (Servicio A)
INVENTORY_SERVICE_URL=http://localhost:4002

# Timeout (ms) al consultar service-inventory; si se supera, responde 502
INVENTORY_TIMEOUT_MS=8000

# Umbral de stock bajo para alertas (existencia <= este valor)
LOW_STOCK_THRESHOLD=5

# IMPORTANTE: debe ser EXACTAMENTE el mismo valor que JWT_SECRET en
# service-auth y service-inventory, ya que este servicio solo verifica
# tokens, no los emite.
JWT_SECRET=changeme
