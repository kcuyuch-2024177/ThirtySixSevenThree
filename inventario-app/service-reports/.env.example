# Puerto del servicio (por defecto 4003)
REPORTS_PORT=4003

# URL base de service-inventory (sin barra final)
INVENTORY_SERVICE_URL=http://localhost:4002

# Timeout (ms) al consultar service-inventory; si se supera, responde 502
INVENTORY_TIMEOUT_MS=8000

# Umbral de stock bajo por defecto para alertas (existencia <= este valor)
LOW_STOCK_THRESHOLD=5

# Debe ser EXACTAMENTE el mismo JWT_SECRET que en service-auth e inventory
JWT_SECRET=changeme
