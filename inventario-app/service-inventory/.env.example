# Puerto en el que se levanta el servicio (por defecto 4002 si no se define)
INVENTORY_PORT=4002

# Cadena de conexión a MongoDB. La base de datos usada será "inventario_inventory"
MONGO_URI=mongodb://localhost:27017/inventario_inventory

# IMPORTANTE: debe ser EXACTAMENTE el mismo valor que JWT_SECRET en
# service-auth, ya que este servicio solo verifica tokens, no los emite.
JWT_SECRET=changeme
