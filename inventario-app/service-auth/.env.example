# Puerto en el que se levanta el servicio (por defecto 4001 si no se define)
AUTH_PORT=4001

# Cadena de conexión a MongoDB. La base de datos usada será "inventario_auth"
MONGO_URI=mongodb://localhost:27017/inventario_auth

# Secreto usado para firmar y verificar los JWT. Cámbialo en producción.
JWT_SECRET=changeme
