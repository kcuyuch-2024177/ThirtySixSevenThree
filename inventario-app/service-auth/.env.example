AUTH_PORT=4001
MONGO_URI=mongodb://localhost:27017/inventario_auth
JWT_SECRET=changeme

# URL del frontend (enlaces de verificación de correo)
FRONTEND_URL=http://localhost:5173

# Dominios de correo permitidos al registrarse (separados por coma)
ALLOWED_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,yahoo.com,live.com,icloud.com,utez.edu.mx

# Caducidad del JWT de verificación de correo
VERIFY_TOKEN_EXPIRES=24h

# SMTP opcional. Si no se configura, el enlace de verificación se imprime en la consola del servidor.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-app-password
# MAIL_FROM=Ynventory <noreply@ynventory.local>
